# ── Geronimo Éclaireur — Variables d'environnement ──────────────
# Copier ce fichier vers .env.local et renseigner les valeurs.

# IA — transcription audio + extraction prosodique (Gemini)
GEMINI_API_KEY=your-gemini-api-key

# IA — analyse des marqueurs DYS/TDAH/TSA (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Base de données Supabase (clés publiques, protégées par RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
